# NetBoost Test Fixture: valid_macos.ovpn (Passepartout OpenVPN Profile)
client
proto udp
explicit-exit-notify
remote vpn2.iiit.ac.in 1194
dev tun
tun-mtu 1200
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name vpn2.iiit.ac.in name
auth SHA256
cipher AES-128-GCM
tls-client
tls-version-min 1.2
tls-cipher TLS-ECDHE-ECDSA-WITH-AES-128-GCM-SHA256
verb 3
auth-user-pass
auth-retry interact
