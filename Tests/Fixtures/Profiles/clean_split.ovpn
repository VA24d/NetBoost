# NetBoost Test Fixture: clean_split.ovpn (Non-conflicting split tunnel)
client
dev tun
proto udp
remote vpn.iiit.ac.in 1194
resolv-retry infinite
nobind
persist-key
persist-tun
verb 3
auth-user-pass
auth-retry interact
remote-cert-tls server
cipher AES-128-GCM
# Clean split tunnel configuration: omits 10.1.0.0/16 to allow direct campus traffic
route-nopull
route 10.4.0.0 255.255.0.0
route 10.8.0.0 255.255.240.0
route 10.10.0.0 255.255.240.0
