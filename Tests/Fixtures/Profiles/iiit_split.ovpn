# NetBoost Test Fixture: iiit_split.ovpn (Contains 10.1.0.0/16 route conflict)
client
dev tun
proto udp
remote vpn.iiit.ac.in 1194
resolv-retry infinite
nobind
persist-key
persist-tun
verb 3
auth-user-pass
auth-retry interact
remote-cert-tls server
cipher AES-128-GCM
# Split tunnel configuration: conflicts with physical campus LAN 10.1.0.0/16
route-nopull
route 10.1.0.0 255.255.0.0
route 10.2.0.0 255.255.0.0
route 10.3.0.0 255.255.0.0
route 10.4.0.0 255.255.0.0
route 10.8.0.0 255.255.240.0
